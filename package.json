    "@trpc/server": "^11.17.0",
    "@vercel/analytics": "^2.0.1",
    "@zxing/browser": "^0.2.0",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.40.0",
    "langfuse": "^3.38.20",
    "lucide-react": "^1.18.0",
    "next": "^16.2.9",
    "pg": "^8.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "serwist": "^9.5.11",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
