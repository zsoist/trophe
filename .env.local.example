# Trophē v0.3 — local development env
# Copy to .env.local and fill in. NEVER commit .env.local.
#
# Production env (Vercel) keeps NEXT_PUBLIC_SUPABASE_* + SUPABASE_SERVICE_ROLE_KEY
# pointing at production Supabase. DATABASE_URL is local-only until Phase 9 cutover.

# ─── Database ─────────────────────────────────────────────────────────────
# CI / Vercel: set to Supabase transaction-pooler URL (port 6543) or direct URL.
# Supabase local stack (default after `supabase start`):
#   DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Mac Mini open_brain_postgres (food data on port 5433):
#   DATABASE_URL=postgresql://trophe_user:CHANGEME@127.0.0.1:5433/trophe_dev
#
# Note: 127.0.0.1 NOT localhost — macOS resolves localhost to ::1 first;
#       Docker containers only bind IPv4.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# PGPASSWORD: required by scripts/ingest/* and scripts/db/migrate-production.sh
# (pg_dump picks it up from env). Match the password in DATABASE_URL.
# PGPASSWORD=

# ─── Supabase (hosted/production environments) ───────────────────────────
# For local work, `npm run dev:local` derives these values from the local
# Supabase CLI stack in memory. No copy/paste of local secrets is required.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# REQUIRED for signup email confirmation (WP1 part 2): the exact origin of THIS
# environment, used as the emailRedirectTo for confirmation links. If unset, signup fails
# closed (503) rather than emailing an ambiguous-redirect link. Per env:
#   local → http://127.0.0.1:3000 | preview → the Vercel preview URL | prod → https://trophe.app
# Must also be in Supabase Auth → URL Configuration → Redirect URLs for each env.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# ─── LLM keys (shared with Mac Mini control plane) ────────────────────────
# Source from ~/.local/secrets/{anthropic,providers,voyage}.env when running
# locally. Production uses Vercel env vars.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...
GEMINI_API_KEY=AI...
VOYAGE_API_KEY=pa-...
# Optional evaluation provider. Store in a secret manager; never commit a real key.
DEEPSEEK_API_KEY=sk-...
# Optional coach/conversation canary only: deepseek-v4-flash or deepseek-v4-pro.
DEEPSEEK_COACH_MODEL=

# ─── Cron worker auth (Supabase pg_cron → pg_net) ─────────────────────────
# Per-worker secrets: each scheduled worker authenticates with its OWN secret, kept in sync
# with its Supabase Vault entry (recovery_cron_secret / memory_cron_secret). See
# docs/ops/recovery-worker-scheduling.md. NEVER commit real values.
# (The legacy shared CRON_SECRET was retired in P2 phase 2 — do not reintroduce it.)
RECOVERY_CRON_SECRET=
MEMORY_CRON_SECRET=

# ─── Langfuse (Mac Mini @ localhost:3002 for local dev) ───────────────────
LANGFUSE_PUBLIC_KEY=pk-...
LANGFUSE_SECRET_KEY=sk-...
LANGFUSE_HOST=http://127.0.0.1:3002

# ─── USDA FoodData Central (optional — falls back to DEMO_KEY) ───────────
USDA_API_KEY=your-usda-key

# ─── Phase 6 (Spike peripherals — only when needed) ───────────────────────
SPIKE_CLIENT_ID=
SPIKE_CLIENT_SECRET=
SPIKE_WEBHOOK_SECRET=
WEARABLE_ENCRYPT_KEY=

# ─── Admin (legacy; replaced by role enum in Phase 1) ─────────────────────
# Comma-separated Supabase user IDs permitted to run controlled production evals.
# Deployment config only; never hardcode eval identities in source.
AI_RATE_LIMIT_BYPASS_USER_IDS=
